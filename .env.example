# Development only. Do not commit actual credentials.
GUARD_HOST=127.0.0.1
GUARD_PORT=4080
DATABASE_URL=postgres://guard:replace-me@127.0.0.1:5432/guard
GUARD_ADMIN_TOKEN=replace-with-an-independent-random-token-at-least-32-characters
GUARD_CONNECTOR_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Explicitly OFF until independently certified financial events are available
GUARD_VERIFIED_EVENTS_ENABLED=NO
# Default dry-run blocks all real restrictions, even when a policy allows them
GUARD_DRY_RUN=YES
